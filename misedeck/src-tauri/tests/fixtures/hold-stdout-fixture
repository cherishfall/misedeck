#!/usr/bin/env bash
# hold-stdout-fixture — a child that exits while a grandchild still holds
# the stdout pipe (issue #222).
#
# The fixture-mise script serves recorded bytes and cannot start a
# process, so this case gets its own script. It mirrors a task that ends
# with `npm run dev &` or a daemon: the direct child exits, but the
# background `sleep` inherited stdout and keeps the write end of the
# pipe open, so a reader waiting for EOF never returns. The runner must
# still deliver this exit code (7) instead of blocking on the reader.
#
# `sleep 10` outlives the runner's one-second reader bound and then
# cleans itself up; the reader thread that was abandoned at the bound
# sees EOF at that point and exits.
set -u
echo "started"
sleep 10 &
echo "leaving"
exit 7
