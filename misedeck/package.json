{
  "name": "misedeck",
  "private": true,
  "version": "1.0.0-beta.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint:i18n": "tsx scripts/check-i18n.ts",
    "lint:i18n-concat": "tsx scripts/check-i18n-concat.ts",
    "lint:css-tokens": "tsx scripts/check-css-tokens.ts",
    "lint:css-font-size": "tsx scripts/check-css-font-size.ts",
    "lint:css-tracking": "tsx scripts/check-css-tracking.ts",
    "lint:i18n-ellipsis": "tsx scripts/check-i18n-ellipsis.ts",
    "lint:command-hint": "tsx scripts/check-command-hint.ts",
    "ci": "npm run typecheck && npm run lint:i18n && npm run lint:i18n-concat && npm run lint:css-tokens && npm run lint:css-font-size && npm run lint:css-spacing && npm run lint:css-tracking && npm run lint:i18n-ellipsis && npm run lint:command-hint && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:css-spacing": "tsx scripts/check-css-spacing.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.12",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
