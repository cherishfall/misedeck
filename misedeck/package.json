{
  "name": "misedeck",
  "private": true,
  "version": "1.0.1",
  "description": "MiseDeck — a faithful GUI for mise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cherishfall/misedeck.git",
    "directory": "misedeck"
  },
  "homepage": "https://github.com/cherishfall/misedeck#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:i18n": "tsx scripts/check-i18n.ts",
    "lint:i18n-concat": "tsx scripts/check-i18n-concat.ts",
    "lint:css-tokens": "tsx scripts/check-css-tokens.ts",
    "lint:css-font-size": "tsx scripts/check-css-font-size.ts",
    "lint:css-tracking": "tsx scripts/check-css-tracking.ts",
    "lint:i18n-ellipsis": "tsx scripts/check-i18n-ellipsis.ts",
    "lint:command-hint": "tsx scripts/check-command-hint.ts",
    "lint:install-echo-parity": "tsx scripts/check-install-echo-parity.ts",
    "lint:argv-parity": "tsx scripts/check-argv-parity.ts",
    "lint:modal-focus": "tsx scripts/check-modal-focus.ts",
    "lint:nested-interactive": "tsx scripts/check-nested-interactive.ts",
    "lint:page-layout": "tsx scripts/check-page-layout.ts",
    "lint:invoke-wrapper": "tsx scripts/check-invoke-wrapper.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ci": "npm run typecheck && npm run lint:eslint && npm run test && npm run lint:i18n && npm run lint:i18n-concat && npm run lint:css-tokens && npm run lint:css-font-size && npm run lint:css-spacing && npm run lint:css-tracking && npm run lint:i18n-ellipsis && npm run lint:command-hint && npm run lint:install-echo-parity && npm run lint:argv-parity && npm run lint:modal-focus && npm run lint:nested-interactive && npm run lint:page-layout && npm run lint:invoke-wrapper && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:css-spacing": "tsx scripts/check-css-spacing.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.12",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.4"
  }
}
